# Enable Rewrite Engine for Clean URLs
RewriteEngine On

# Redirect all requests to index.php if file or directory doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

# Force HTTPS (If SSL is enabled)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct access to important files (Security)
<FilesMatch "(^\.htaccess|\.env|config\.php|db\.php)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Custom Error Pages
ErrorDocument 403 /html/errors/403.php
ErrorDocument 404 /html/errors/404.php
ErrorDocument 500 /html/errors/500.php

# Set PHP settings (Optional)
php_flag display_errors Off
php_flag log_errors On
php_value error_log logs/php_error.log

# Caching (Improves Performance)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
</IfModule>
