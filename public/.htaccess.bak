# public/.htaccess

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If deploying under a subfolder (e.g., https://example.com/libertys/),
  # also set BASE_PATH=/libertys in .env and optionally uncomment:
  # RewriteBase /libertys/

  # Let real files through (assets, HTML, JS, CSS, API endpoint PHP, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # IMPORTANT: allow direct API endpoint access under /public/api/
  RewriteRule ^api/ - [L]

  # Everything else -> index.php (front controller)
  RewriteRule ^ index.php [L]
</IfModule>

# Optional custom errors if you keep these files:
# ErrorDocument 404 /html/errors/404.html
# ErrorDocument 500 /html/errors/500.html
