# .htaccess file for Liberty's Path application

# Enable the rewrite engine
RewriteEngine On

# Set the base directory - adjust if your application is in a subdirectory
RewriteBase /libertys_path_api/

# Prevent direct access to sensitive directories
RewriteRule ^php/config/ - [F,L]
RewriteRule ^vendor/ - [F,L]

# Important: Don't rewrite requests for actual files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Handle dashboard URLs
RewriteRule ^dashboard$ php/dashboard/dashboard.php [L]
RewriteRule ^dashboard/$ php/dashboard/dashboard.php [L]
RewriteRule ^dashboard_view$ php/dashboard/dashboard.php [L]
RewriteRule ^dashboard_view/$ php/dashboard/dashboard.php [L]

# Handle student registration
RewriteRule ^register_student$ php/dashboard/student_register.php [L]
RewriteRule ^register_student/$ php/dashboard/student_register.php [L]

# Handle authentication
RewriteRule ^login$ html/login.html [L]
RewriteRule ^login/$ html/login.html [L]
RewriteRule ^logout$ php/auth/logout.php [L]
RewriteRule ^logout/$ php/auth/logout.php [L]

# Handle student monitoring
RewriteRule ^student_monitoring$ php/dashboard/student_monitoring.php [L]
RewriteRule ^student_monitoring/$ php/dashboard/student_monitoring.php [L]

# Prevent directory listing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

# Enable CORS for API
<IfModule mod_headers.c>
    <FilesMatch "^api/">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type"
    </FilesMatch>
</IfModule>

# PHP settings
<IfModule mod_php7.c>
    # Maximum execution time
    php_value max_execution_time 60
    
    # Maximum file upload size
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    
    # Error handling
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log logs/php_errors.log
</IfModule>

# Custom error pages
ErrorDocument 404 /libertys_path_api/html/errors/404.html
ErrorDocument 500 /libertys_path_api/html/errors/500.html

# Cache control for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>